{
  "name": "outlook-for-linux",
  "version": "0.3.0",
  "main": "app/index.js",
  "description": "Unofficial client for Microsoft Outlook for Linux",
  "homepage": "https://github.com/Brumhilde/outlook-for-linux",
  "keywords": [
    "Outlook",
    "Microsoft Outlook",
    "Outlook on the web",
    "Email",
    "Microsoft 365"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://github.com/Brumhilde/outlook-for-linux"
  },
  "author": {
    "name": "Outlook for Linux contributors",
    "url": "https://github.com/Brumhilde/outlook-for-linux"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint **/*.js",
    "test:unit": "node --test 'tests/unit/*.test.js'",
    "test:e2e": "playwright test",
    "test:authenticated": "playwright test --config playwright.authenticated.config.js",
    "prestart": "npm ci",
    "start": "electron ./app --trace-warnings",
    "start:dev": "electron ./app --trace-warnings --no-sandbox",
    "generate-release-info": "node scripts/generateReleaseInfo.js",
    "generate-ipc-docs": "node scripts/generateIpcDocs.js",
    "generate-config-docs": "node scripts/generateConfigDocs.js",
    "prebuild": "npm run generate-release-info",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:linux:targz": "electron-builder --x64 --arm64 -l tar.gz",
    "dist:linux:deb": "electron-builder --x64 --arm64 -l deb",
    "dist:linux:rpm": "electron-builder --x64 --arm64 -l rpm",
    "dist:linux:appimage": "electron-builder --x64 --arm64 -l AppImage",
    "dist:linux:snap": "electron-builder -l snap",
    "dist:mac": "electron-builder --mac --x64 --arm64 -c.mac.identity=-",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:linux:x64": "electron-builder --x64 -l tar.gz deb rpm AppImage",
    "dist:linux:arm64": "electron-builder --arm64 -l tar.gz deb rpm AppImage",
    "release": "electron-builder"
  },
  "dependencies": {
    "@homebridge/dbus-native": "0.7.9",
    "cbor-x": "^1.6.6",
    "electron-log": "^5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "5.0.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.7",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  },
  "build": {
    "appId": "outlook-for-linux",
    "protocols": {
      "name": "Email",
      "schemes": [
        "mailto"
      ]
    },
    "extraResources": [
      {
        "from": "app/assets/sounds",
        "to": "assets/sounds"
      }
    ],
    "linux": {
      "category": "Office;Email;Network",
      "packageCategory": "mail",
      "executableName": "outlook-for-linux",
      "synopsis": "Outlook for Linux",
      "maintainer": "Brumhilde <Brumhilde@users.noreply.github.com>",
      "description": "Unofficial Microsoft Outlook client for Linux using Electron. It wraps Outlook on the web (Microsoft 365 or Outlook.com) as a standalone application with tray unread count, desktop notifications and mailto: link handling.",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "desktop": {
        "entry": {
          "Name": "Outlook for Linux",
          "Comment": "Unofficial client for Microsoft Outlook for Linux",
          "Keywords": "email;mail;calendar;outlook;office;microsoft;"
        }
      },
      "target": [
        "rpm",
        "deb",
        "tar.gz",
        "AppImage"
      ],
      "publish": {
        "provider": "github",
        "releaseType": "draft"
      },
      "releaseInfo": {
        "releaseNotesFile": "release-info.json"
      }
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)"
      ],
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links  none",
        "--rpm-digest=sha256",
        "--rpm-tag=Recommends: fido2-tools"
      ]
    },
    "deb": {
      "recommends": [
        "libappindicator3-1",
        "fido2-tools"
      ]
    },
    "snap": {
      "summary": "Outlook for Linux",
      "confinement": "strict",
      "grade": "stable",
      "base": "core22",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "plugs": [
        "default",
        "network-bind",
        "network-manager-observe",
        "removable-media"
      ],
      "publish": [
        "github"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterPack": "scripts/afterpack.js"
  }
}
